---
import Base from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ClosureNotice from "../components/ClosureNotice.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { venues } from "../data/site";
---

<Base
  title="Juhlat ja kokoukset | Gasthaus Pooki"
  description="JuhlaPooki jopa 60 hengelle, kabinetti 10 hengelle ja kesäinen Liiteri 70 hengelle. Pyydä tarjous Gasthaus Pookista Uudestakaupungista."
>
  <PageHero
    eyebrow="Juhlat ja kokoukset"
    title="Tilaa juhlaan, kokoukseen tai kesäiltaan."
    lede="Pookissa on kolme erilaista tilaa: JuhlaPooki, kabinetti ja kesäkauden Liiteri. Vehreä sisäpiha täydentää kesän juhlia."
  />

  <section class="wrap grid gap-6 py-16 md:py-20">
    <ClosureNotice />
    <div class="grid gap-4 md:grid-cols-3">
      {
        venues.map((venue) => (
          <article class="overflow-hidden border border-line bg-paper">
            <img src={venue.image} alt={venue.alt} class="aspect-[5/4] w-full object-cover" decoding="async" />
            <div class="p-6">
              <p class="font-serif text-6xl text-sea">{venue.capacity}</p>
              <p class="mt-1 text-xs font-semibold tracking-[0.16em] uppercase text-brass-deep">{venue.unit}</p>
              <h2 class="mt-4 font-serif text-4xl text-sea">{venue.name}</h2>
              <p class="mt-3 text-muted">{venue.text}</p>
              <p class="mt-3 text-sm text-brass-deep">{venue.note}</p>
            </div>
          </article>
        ))
      }
    </div>
    <p class="max-w-3xl text-muted">
      Kesäpiha ja Lyökin pookin pienoismalli ovat osa talon tunnelmaa. Piha mainitaan talon omissa
      esittelyissä omana kohtanaan. Juhlien järjestelyistä sovitaan puhelimitse.
    </p>
  </section>

  <section id="tarjous" class="scroll-mt-24 bg-paper">
    <div class="wrap max-w-3xl py-16 md:py-20">
      <InquiryForm
        formName="tarjouspyynto"
        heading="Pyydä tarjous"
        showEventFields
      />
    </div>
  </section>
</Base>
