---
import Base from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { amenities, site } from "../data/site";
---

<Base
  title="Majoitus | Gasthaus Pooki"
  description="Neljä kahden hengen huonetta Gasthaus Pookissa: oma suihku, kaapeli-tv, langaton verkko ja runsas aamiainen. Ylinenkatu 21, Uusikaupunki."
>
  <PageHero
    eyebrow="Majoitus"
    title="Neljä huonetta, neljä tunnelmaa."
    lede="Kaikki huoneet ovat kahden hengen huoneita. Jokaisessa on oma suihku, kaapeli‑tv ja langaton internetyhteys. Huoneen hintaan sisältyy runsas aamiainen."
  />

  <section class="wrap py-16 md:py-20">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        amenities.map((item) => (
          <li class="border border-line bg-paper p-5">
            <h2 class="font-serif text-3xl text-sea">{item.title}</h2>
            <p class="mt-2 text-sm text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>

    <figure class="mt-14 overflow-hidden">
      <img
        src="/kuvat/slider-huone.jpg"
        alt="Kahden hengen huone meriaiheisella tapetilla, sinisin verhoin ja parivuoteella."
        class="aspect-[16/10] w-full object-cover"
        decoding="async"
      />
      <figcaption class="mt-3 text-sm text-muted">Yksi neljästä huoneesta.</figcaption>
    </figure>
  </section>

  <section id="varaus" class="scroll-mt-24 bg-paper">
    <div class="wrap grid gap-10 py-16 md:grid-cols-2 md:py-20">
      <div>
        <p class="eyebrow text-brass-deep">Käytännön asiat</p>
        <h2 class="mt-3 font-serif text-5xl text-sea">Aamiainen ja saapuminen.</h2>
        <dl class="mt-8 grid gap-5">
          <div>
            <dt class="font-semibold">Aamiainen</dt>
            <dd class="text-muted">Sisältyy huoneen hintaan. Kesäisin aamiaisen voi nauttia myös sisäpihalla.</dd>
          </div>
          <div>
            <dt class="font-semibold">Sisäänkirjautuminen</dt>
            <dd class="text-muted">Kello {site.checkIn}. Uloskirjautuminen kello {site.checkOut}. Poikkeuksista voi sopia puhelimitse.</dd>
          </div>
          <div>
            <dt class="font-semibold">Sijainti</dt>
            <dd class="text-muted">{site.street}, {site.postalCode} {site.city}, torin laidalla.</dd>
          </div>
        </dl>
      </div>
      <div class="flex flex-col items-start justify-center gap-4 border border-line bg-cream p-8">
        <h2 class="font-serif text-4xl text-sea">Varaa huone</h2>
        <p class="text-muted">Nopeimmin varaus hoituu puhelimella. Verkossa huoneen voi varata Booking.comissa.</p>
        <a href={site.phoneHref} class="btn btn-sea">{site.phoneDisplay}</a>
        <a href={site.bookingUrl} class="btn btn-line text-sea" target="_blank" rel="noopener noreferrer">
          Varaa Booking.comissa
        </a>
      </div>
    </div>
  </section>
</Base>
