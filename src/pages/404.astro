---
import Base from "../layouts/BaseLayout.astro";
---

<Base
  title="Sivua ei löytynyt | Gasthaus Pooki"
  description="Etsimääsi sivua ei ole Gasthaus Pookin sivustolla."
  noindex
>
  <section class="wrap pb-24 pt-36 md:pt-44">
    <p class="eyebrow text-brass-deep">404</p>
    <h1 class="mt-4 font-serif text-6xl text-sea">Tätä sivua ei löytynyt.</h1>
    <p class="mt-6 max-w-xl text-lg text-muted">
      Osoite on voinut muuttua. Majoitus, juhlat ja yhteystiedot löytyvät etusivulta.
    </p>
    <a href="/" class="btn btn-sea mt-8">Etusivulle</a>
  </section>
</Base>
