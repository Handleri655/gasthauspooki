---
import Beacon from "./Beacon.astro";
import { nav, site } from "../data/site";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  return href === "/" ? path === "/" : path === href;
}
---

<header class:list={["site-header", overlay ? "is-overlay" : "is-solid"]} data-header>
  <div class="wrap flex h-16 items-center justify-between gap-4 md:h-20">
    <a href="/" class="flex items-center gap-3 no-underline">
      <Beacon class="h-9 w-8 shrink-0" />
      <span class="leading-none">
        <span class="block font-serif text-[1.55rem] tracking-normal">Gasthaus Pooki</span>
        <span class="mt-1 block text-[0.62rem] font-semibold tracking-[0.18em] uppercase">Uusikaupunki</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Päävalikko">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "text-sm no-underline",
              isActive(item.href) ? "underline decoration-brass underline-offset-8" : "hover:underline hover:decoration-brass hover:underline-offset-8",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <a href={site.phoneHref} class="hidden text-sm no-underline xl:inline">{site.phoneDisplay}</a>
      <a href="/majoitus#varaus" class="btn btn-line">Varaa</a>
    </div>

    <button
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center lg:hidden"
      aria-expanded="false"
      aria-controls="sivumenu"
      data-menu-button
    >
      <span class="sr-only" data-menu-label>Avaa valikko</span>
      <span class="relative block h-4 w-5" aria-hidden="true" data-menu-icon>
        <span class="absolute left-0 top-0 h-px w-full bg-current"></span>
        <span class="absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-current"></span>
        <span class="absolute bottom-0 left-0 h-px w-full bg-current"></span>
      </span>
    </button>
  </div>
</header>

<div id="sivumenu" class="fixed inset-x-0 bottom-0 top-16 z-40 hidden overflow-auto bg-cream text-sea md:top-20 lg:hidden" data-menu-panel hidden>
  <nav class="wrap flex flex-col gap-2 py-8 pb-28" aria-label="Mobiilivalikko">
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class="border-b border-line py-3 font-serif text-4xl no-underline"
        >
          {item.label}
        </a>
      ))
    }
    <a href={site.phoneHref} class="mt-6 text-lg no-underline">{site.phoneDisplay}</a>
    <a href="mailto:info@gasthauspooki.fi" class="no-underline">{site.email}</a>
  </nav>
</div>

<script>
  let abort = new AbortController();

  function initHeader() {
    abort.abort();
    abort = new AbortController();
    const { signal } = abort;

    const header = document.querySelector<HTMLElement>("[data-header]");
    const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
    const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
    const label = document.querySelector<HTMLElement>("[data-menu-label]");
    if (!header || !button || !panel || !label) return;

    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 8);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true, signal });

    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      label.textContent = open ? "Sulje valikko" : "Avaa valikko";
      header.classList.toggle("is-open", open);
      panel.classList.toggle("hidden", !open);
      panel.toggleAttribute("hidden", !open);
      document.body.classList.toggle("overflow-hidden", open);
      if (open) {
        const first = panel.querySelector<HTMLAnchorElement>("a");
        first?.focus();
      }
    };

    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    }, { signal });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false), { signal });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        button.focus();
      }
    }, { signal });
  }

  document.addEventListener("astro:page-load", initHeader);
  initHeader();
</script>
